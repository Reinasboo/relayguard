# SQLite path for the local authorization store. Keep the database outside the web root.
RELAYGUARD_DATABASE_PATH=./data/relayguard.sqlite
# Set DATABASE_URL in hosted environments to use Supabase Postgres instead of local SQLite.
DATABASE_URL=
# Optional Supabase database CA PEM for verified TLS (server-side only).
SUPABASE_DB_CA_CERT=

# Mezo adapter configuration
MEZO_RPC_URL=https://rpc.test.mezo.org
MEZO_NETWORK=testnet
MEZO_PRIVATE_KEY=0x<64-hex-chars>
MEZO_SIGNER_ADDRESS=0x<address>
MEZO_TOKEN_ADDRESS=0x<erc20-musd-address>
MEZO_ALLOWED_RECIPIENTS=0x<first-approved-address>,0x<second-approved-address>
MEZO_MERCHANT_NAME=RelayGuard Test Merchant
MEZO_MERCHANT_ADDRESS=0x<merchant-address-also-in-allowed-recipients>
MEZO_AGENT_ID=relayguard-demo-agent
MEZO_APPROVER_ID=local-operator
MEZO_MAX_TRANSACTION=0.001
MEZO_DAILY_LIMIT=0.005
MEZO_APPROVAL_THRESHOLD=0.0005
MEZO_MUSD_MAX_TRANSACTION=25
MEZO_MUSD_DAILY_LIMIT=100
MEZO_MUSD_APPROVAL_THRESHOLD=10
PORT=4173

# Supabase Auth (use the publishable key only; never expose a service-role key)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<public-key>
SUPABASE_REDIRECT_URL=http://127.0.0.1:4173/
PUBLIC_ORIGIN=
PUBLIC_HOSTNAME=

# x402 MUSD API monetization (Mezo Testnet only)
X402_ENABLED=false
X402_FACILITATOR_URL=https://facilitator.vativ.io
X402_PAY_TO=0x<merchant-address>
X402_PRICE=$0.001

# The demo defaults to 127.0.0.1 and is restricted to Mezo testnet.
# For MUSD, verify the testnet contract and token symbol before setting the address.
