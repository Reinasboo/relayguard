{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; connect-src 'self' https://*.supabase.co https://facilitator.vativ.io; img-src 'self' data:; style-src 'self'; script-src 'self'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'; form-action 'self'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ],
  "functions": {
    "api/[...path].js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/review",
      "destination": "/review.html"
    },
    {
      "source": "/api/paid-resource",
      "destination": "/api/config?__relayguard_path=/api/paid-resource"
    },
    {
      "source": "/api/:route/:path+",
      "destination": "/api/config?__relayguard_path=/api/:route/:path*"
    },
    {
      "source": "/pay/:path*",
      "destination": "/api/config?__relayguard_path=/pay/:path*"
    }
  ]
}
